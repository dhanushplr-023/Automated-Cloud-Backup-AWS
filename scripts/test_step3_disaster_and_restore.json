{
  "InstanceIds": ["i-0235c395276dc0851"],
  "DocumentName": "AWS-RunShellScript",
  "Parameters": {
    "commands": [
      "echo '=== SIMULATING DISASTER: DELETING PRODUCTION DATA ==='",
      "rm -rf /var/data/important/*",
      "echo 'Checking directory after disaster (should be empty):'",
      "ls -A /var/data/important || echo 'DIRECTORY IS EMPTY - DATA LOST!'",
      "",
      "echo '=== LOCATING LATEST BACKUP IN S3 ==='",
      "S3_BUCKET='cloud-backup-vault-9k6tfc'",
      "RESTORE_STAGING='/tmp/restore_staging'",
      "RESTORE_DIR='/var/data/important'",
      "mkdir -p \"${RESTORE_STAGING}\" \"${RESTORE_DIR}\"",
      "",
      "LATEST_BACKUP=$(aws s3 ls \"s3://${S3_BUCKET}/backups/\" --recursive | grep '.tar.gz$' | tail -n 1 | awk '{print $4}')",
      "ARCHIVE_NAME=$(basename \"${LATEST_BACKUP}\")",
      "echo \"Found latest backup: ${LATEST_BACKUP}\"",
      "",
      "echo '=== DOWNLOADING ARCHIVE & CHECKSUM ==='",
      "aws s3 cp \"s3://${S3_BUCKET}/${LATEST_BACKUP}\" \"${RESTORE_STAGING}/${ARCHIVE_NAME}\"",
      "aws s3 cp \"s3://${S3_BUCKET}/${LATEST_BACKUP}.sha256\" \"${RESTORE_STAGING}/${ARCHIVE_NAME}.sha256\"",
      "",
      "echo '=== CRYPTOGRAPHIC SHA-256 VERIFICATION ==='",
      "EXPECTED_HASH=$(awk '{print $1}' \"${RESTORE_STAGING}/${ARCHIVE_NAME}.sha256\")",
      "ACTUAL_HASH=$(sha256sum \"${RESTORE_STAGING}/${ARCHIVE_NAME}\" | awk '{print $1}')",
      "echo \"Expected Hash : ${EXPECTED_HASH}\"",
      "echo \"Calculated Hash: ${ACTUAL_HASH}\"",
      "",
      "if [ \"${EXPECTED_HASH}\" != \"${ACTUAL_HASH}\" ]; then",
      "    echo '[ERROR] Checksum mismatch! Corrupt backup.'",
      "    exit 1",
      "fi",
      "echo '[SUCCESS] Cryptographic verification PASSED! Zero data corruption.'",
      "",
      "echo '=== EXTRACTING RECOVERED FILES TO /var/data/important/ ==='",
      "tar -xzvf \"${RESTORE_STAGING}/${ARCHIVE_NAME}\" -C \"${RESTORE_DIR}\"",
      "rm -rf \"${RESTORE_STAGING}\"",
      "",
      "echo '=== VERIFYING RECOVERED FILES ==='",
      "ls -lh \"${RESTORE_DIR}\"",
      "echo '=== VERIFYING RECOVERED NEW ORDER ==='",
      "cat \"${RESTORE_DIR}/new_orders.json\"",
      "echo '=== VERIFYING RECOVERED CUSTOMER ==='",
      "cat \"${RESTORE_DIR}/customers.csv\"",
      "echo '=== DISASTER RECOVERY DRILL COMPLETED SUCCESSFULLY ==='"
    ]
  }
}
